#!/usr/bin/env bash
# Refuse to push any commit whose message carries AI attribution, even one made with --no-verify.
# Enabled per clone with: git config core.hooksPath .githooks
set -euo pipefail
pattern='(co-authored-by:.*(claude|anthropic)|generated with.*claude|noreply@anthropic\.com|claude code|anthropic)'
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %s%n%b' "$range" 2>/dev/null | grep -iE "$pattern" || true)
  if [ -n "$bad" ]; then
    echo "pre-push: rejected — commits in $range contain Claude/Anthropic attribution:" >&2
    git log --format='  %h %s' "$range" -- 2>/dev/null | head -20 >&2
    echo "Rewrite those messages (git commit --amend / git rebase -i) and push again." >&2
    status=1
  fi
done
exit $status
